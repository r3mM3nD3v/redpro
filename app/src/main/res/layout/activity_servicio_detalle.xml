<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título del servicio -->
        <TextView
            android:id="@+id/tvTituloServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título del servicio"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="4dp" />

        <!-- Categoría -->
        <TextView
            android:id="@+id/tvCategoriaServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="2dp" />

        <!-- Precio -->
        <TextView
            android:id="@+id/tvPrecioServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USD 0.00"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Ubicación -->
        <TextView
            android:id="@+id/tvUbicacionServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="12dp" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcionServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción del servicio"
            android:textColor="@color/textPrimary"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp" />

        <!-- Datos del profesional -->
        <TextView
            android:id="@+id/tvNombreProfesional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del profesional"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvTelefonoProfesional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teléfono"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvEmailProfesional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="24dp" />

        <!-- Botón WhatsApp -->
        <Button
            android:id="@+id/btnWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contactar por WhatsApp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/onPrimary"
            android:padding="12dp"
            android:textAllCaps="false"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
