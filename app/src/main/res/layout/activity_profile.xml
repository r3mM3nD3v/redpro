<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Toolbar común -->
    <include
        layout="@layout/toolbar_logo"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />


    <!-- Contenido principal debajo del toolbar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:fillViewport="true"
        android:background="@color/bg">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- IMAGEN DE PERFIL REDONDA -->
            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/placeholder"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_bg"
                android:padding="2dp"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:adjustViewBounds="true" />

            <!-- BOTÓN CAMBIAR FOTO -->
            <Button
                android:id="@+id/btnPickImage"
                android:text="Cambiar foto"
                android:backgroundTint="@color/primary"
                android:textColor="@color/onPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" />

            <!-- TARJETA DE DATOS -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Nombre -->
                <EditText
                    android:id="@+id/etName"
                    android:hint="Nombre"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Space android:layout_width="0dp" android:layout_height="12dp"/>

                <!-- Teléfono -->
                <EditText
                    android:id="@+id/etPhone"
                    android:hint="Teléfono"
                    android:inputType="phone"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Space android:layout_width="0dp" android:layout_height="12dp"/>

                <!-- Dirección -->
                <EditText
                    android:id="@+id/etAddress"
                    android:hint="Dirección"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Space android:layout_width="0dp" android:layout_height="12dp"/>

                <!-- Acerca de mí -->
                <EditText
                    android:id="@+id/etAbout"
                    android:hint="Acerca de mí"
                    android:background="@drawable/input_bg"
                    android:padding="12dp"
                    android:gravity="top"
                    android:minLines="3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Space android:layout_width="0dp" android:layout_height="20dp"/>

                <!-- GUARDAR -->
                <Button
                    android:id="@+id/btnSave"
                    android:text="Guardar cambios"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/onPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
