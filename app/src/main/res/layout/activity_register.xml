<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@color/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 🔵 LOGO ARRIBA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="158dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/appLogo"
                android:layout_width="157dp"
                android:layout_height="146dp"
                android:layout_marginBottom="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="App Logo"
                android:scaleType="centerInside"
                android:src="@drawable/prueba_app" />
        </LinearLayout>

        <!-- Tarjeta -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/card"
            android:elevation="10dp"
            android:layout_margin="20dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">

            <!-- Título -->
            <TextView
                android:text="Crear cuenta"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Nombre -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/nombre"
                    android:padding="12dp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="0dp" android:layout_height="12dp" />

            <!-- Correo -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/correo"
                    android:inputType="textEmailAddress"
                    android:padding="12dp"/>

            </com.google.android.material.textfield.TextInputLayout>


            <Space android:layout_width="0dp" android:layout_height="12dp" />

            <!-- Contraseña con OJITO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/contrasena"
                    android:padding="12dp"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>


            <Space android:layout_width="0dp" android:layout_height="18dp" />

            <!-- Rol -->
            <TextView
                android:text="Selecciona tu rol"
                android:textSize="16sp"
                android:textColor="@color/textSecondary"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <RadioGroup
                android:id="@+id/rgRol"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbCliente"
                    android:text="@string/rol_cliente"
                    android:textColor="@color/black"
                    android:checked="true"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <RadioButton
                    android:id="@+id/rbProfesional"
                    android:text="@string/rol_profesional"
                    android:layout_marginStart="24dp"
                    android:textColor="@color/black"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
            </RadioGroup>

            <Space android:layout_width="0dp" android:layout_height="22dp" />

            <!-- Botón -->
            <Button
                android:id="@+id/btnRegister"
                android:text="@string/registrarse"
                android:backgroundTint="@color/primary"
                android:textColor="@color/onPrimary"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
