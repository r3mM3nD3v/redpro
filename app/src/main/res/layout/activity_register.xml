<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillViewport="true"
    android:background="@color/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 🔵 LOGO / ICONO ARRIBA -->

        <!-- Tarjeta elegante -->
        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="App Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/prueba_app" />



        <!-- Tarjeta de registro -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/card"
            android:elevation="10dp"
            android:layout_margin="20dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">

            <!-- Título -->
            <TextView
                android:text="Crear cuenta"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Nombre -->
            <EditText
                android:id="@+id/etNombre"
                android:hint="@string/nombre"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Space android:layout_width="0dp" android:layout_height="12dp" />

            <!-- Correo -->
            <EditText
                android:id="@+id/etEmail"
                android:hint="@string/correo"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Space android:layout_width="0dp" android:layout_height="12dp" />

            <!-- Contraseña -->
            <EditText
                android:id="@+id/etPass"
                android:hint="@string/contrasena"
                android:inputType="textPassword"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Space android:layout_width="0dp" android:layout_height="18dp" />

            <!-- Rol -->
            <TextView
                android:text="Selecciona tu rol"
                android:textSize="16sp"
                android:textColor="@color/textSecondary"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <RadioGroup
                android:id="@+id/rgRol"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbCliente"
                    android:text="@string/rol_cliente"
                    android:textColor="@color/black"
                    android:checked="true"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <RadioButton
                    android:id="@+id/rbProfesional"
                    android:text="@string/rol_profesional"
                    android:layout_marginStart="24dp"
                    android:textColor="@color/black"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
            </RadioGroup>

            <Space android:layout_width="0dp" android:layout_height="22dp" />

            <!-- Botón Registrarse -->
            <Button
                android:id="@+id/btnRegister"
                android:text="@string/registrarse"
                android:backgroundTint="@color/primary"
                android:textColor="@color/onPrimary"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
